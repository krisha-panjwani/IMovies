{
  "name": "imovies-server",
  "version": "1.0.0",
  "description": "IMovies REST API - Express + MongoDB backend for movie ticket booking and CineMood",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:demo": "node scripts/dev-memory.js",
    "seed": "node seed/seed.js --reset",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "keywords": [
    "mern",
    "movie-booking",
    "express",
    "mongodb"
  ],
  "author": "Krisha Panjwani",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14"
  }
}
