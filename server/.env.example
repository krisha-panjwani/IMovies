# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file - it is listed in .gitignore.

# Port the API listens on
PORT=8000

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Replace <username>, <password> and <cluster> with your own values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/imovies?retryWrites=true&w=majority

# Long random string used to sign login tokens (JWT).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Frontend URL(s) allowed to call this API (comma separated)
CLIENT_URL=http://localhost:5173

# Demo accounts created by "npm run seed" (development only - change them)
SEED_ADMIN_EMAIL=admin@imovies.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_EMAIL=demo@imovies.dev
SEED_DEMO_PASSWORD=Demo@12345
